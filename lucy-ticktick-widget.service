[Unit]
Description=Lucy Agenda desktop widget
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 4
ExecStart=/usr/bin/python3 /home/josh/.local/share/lucy-ticktick-widget/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
